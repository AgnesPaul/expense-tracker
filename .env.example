# Backend
DATABASE_URL=postgres://expense:expense@localhost:5432/expense
PORT=3000

# Phase 7 — flip to true to make /health return 503 and watch the ALB react
FORCE_UNHEALTHY=false

# Set this to the RDS-managed secret's name or ARN and the app fetches the
# database password itself at startup — no password on the machine at all.
# DB_SECRET_ID=rds!db-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# PGSSL=true

# Phase 5 — receipts
# RECEIPTS_BUCKET=expense-receipts-<your-suffix>
# AWS_REGION=ap-south-1

# Frontend (optional; empty means same-origin, which is what CloudFront gives us)
# VITE_API_URL=

# Phase 8 — ship container logs to CloudWatch instead of keeping them on the
# instance. EC2 only; needs logs:* on the instance role.
# COMPOSE_FILE=docker-compose.yml:docker-compose.logging.yml
